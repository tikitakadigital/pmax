# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret — generate with: openssl rand -base64 64
ADMIN_JWT_SECRET=replace-with-64-char-random-string

# Resend (for password reset emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin email — who receives reset mails and gets initial account
ADMIN_EMAIL=hello@pmax.online

# Public origin allowed to call /api/consent and /api/leads
PMAX_ORIGIN=https://pmax.online

# Used in reset-password emails
ADMIN_URL=https://admin.pmax.online
