Options -Indexes

# Allow only Cloudflare edge IPs — block direct origin access
# Source: https://www.cloudflare.com/ips/
<IfModule mod_authz_core.c>
  <RequireAny>
    Require ip 173.245.48.0/20
    Require ip 103.21.244.0/22
    Require ip 103.22.200.0/22
    Require ip 103.31.4.0/22
    Require ip 141.101.64.0/18
    Require ip 108.162.192.0/18
    Require ip 190.93.240.0/20
    Require ip 188.114.96.0/20
    Require ip 197.234.240.0/22
    Require ip 198.41.128.0/17
    Require ip 162.158.0.0/15
    Require ip 104.16.0.0/13
    Require ip 104.24.0.0/14
    Require ip 172.64.0.0/13
    Require ip 131.0.72.0/22
    Require ip 2400:cb00::/32
    Require ip 2606:4700::/32
    Require ip 2803:f800::/32
    Require ip 2405:b500::/32
    Require ip 2405:8100::/32
    Require ip 2a06:98c0::/29
    Require ip 2c0f:f248::/32
  </RequireAny>
</IfModule>

# 404 page
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-XSS-Protection "0"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "cross-origin"
  Header unset X-Powered-By
</IfModule>

# Block deploy artefacts and hidden files
<FilesMatch "^(deploy_.*\.zip|\.env.*|\.git.*)$">
  Require all denied
</FilesMatch>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml
</IfModule>

# Long-term caching for hashed Next.js assets (_next/static/)
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico|gif)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML — always revalidate
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, no-cache"
  </FilesMatch>
</IfModule>

# Rewrite rules for clean Next.js static export routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 redirects for legacy/external URLs
  RewriteRule ^category/news/?$ /blog/ [R=301,L]
  RewriteRule ^cookie-policy/?$ /legal/cookies/ [R=301,L]
  RewriteRule ^legal-notice/?$ /legal/imprint/ [R=301,L]
  RewriteRule ^privacy-policy/?$ /legal/privacy/ [R=301,L]

  # Redirect www to non-www (canonical domain)
  RewriteCond %{HTTP_HOST} ^www\.pmax\.online [NC]
  RewriteRule ^(.*)$ https://pmax.online/$1 [R=301,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Add trailing slash for paths without extension
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+)$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]
</IfModule>
